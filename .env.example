APP_NAME=DocBrain
APP_VERSION=0.1.0
ENVIRONMENT=local
ENABLE_DOCS=true
JWT_SECRET=change-me-in-production-with-32-bytes
JWT_ISSUER=docbrain
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

DATABASE_URL=postgresql+psycopg://docbrain:docbrain@localhost:5432/docbrain
REDIS_URL=redis://localhost:6379/0

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=docbrain-local
OBJECT_STORAGE_ACCESS_KEY=docbrain
OBJECT_STORAGE_SECRET_KEY=docbrain-secret
